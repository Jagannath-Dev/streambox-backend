{
  "name": "streambox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Streambox backend — Fastify shell",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check": "tsx scripts/check-response.ts && tsx scripts/check-seedr-utils.ts && tsx scripts/check-quality.ts && tsx scripts/check-tmdb-resolve.ts && tsx scripts/check-poster-url.ts && tsx scripts/check-language.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@supabase/supabase-js": "^2.110.9",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "redis": "^6.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
