NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public server URL for Swagger (optional). Leave empty for localhost-only.
# PUBLIC_URL=https://api.your-domain.com
LOG_LEVEL=info

# Supabase (movies catalog)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seedr.cc — OAuth password grant → Bearer
SEEDR_EMAIL=you@example.com
SEEDR_PASSWORD=your-seedr-password
SEEDR_BASE_URL=https://www.seedr.cc
SEEDR_ACCESS_TOKEN=
SEEDR_REFRESH_TOKEN=

# TMDB (autocomplete search)
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Redis (movie + autocomplete cache). Leave empty to disable.
REDIS_URL=redis://127.0.0.1:6379

# Live 5movierulz mirror — search/detail posters rewritten to this host
MOVIES_RULSZ=https://www.5movierulz.vote/
