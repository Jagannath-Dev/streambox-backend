# cp .env.example .env

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional — Swagger “Server” URL
PUBLIC_URL=

# Supabase (movies + seedr_db)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seedr — email/password/tokens in Supabase table seedr_db (id=1)
SEEDR_BASE_URL=https://www.seedr.cc

# TMDB
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Redis — leave empty / omit to use compose redis service (redis://redis:6379)
# Or set a remote Redis:
# REDIS_URL=redis://:password@redis.example.com:6379
REDIS_URL=

# Movie poster host rewrite
MOVIES_RULSZ=https://www.5movierulz.vote/
