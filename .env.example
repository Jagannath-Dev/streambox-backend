# Copy to .env and fill values:
#   cp .env.example .env
#
# Docker Compose loads this via env_file + environment.
# Inside containers, REDIS_URL is overridden to redis://redis:6379

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Public API URL for Swagger “Server” dropdown (optional)
# PUBLIC_URL=https://api.your-domain.com
PUBLIC_URL=

# Supabase (movies + seedr_db)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seedr.cc — email / password / tokens live in Supabase table seedr_db (id=1)
SEEDR_BASE_URL=https://www.seedr.cc

# TMDB
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Redis — local pnpm use 127.0.0.1; Docker Compose overrides to redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Live 5movierulz mirror for movie poster URLs
MOVIES_RULSZ=https://www.5movierulz.vote/
